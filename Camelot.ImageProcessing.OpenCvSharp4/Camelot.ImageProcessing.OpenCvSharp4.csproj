<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework (net10.0), Nullable, ImplicitUsings and LangVersion come from
       ..\Directory.Build.props (Semita internal standard). -->
  <PropertyGroup>
    <PackageTags>pdf, extract, table, camelot, pdfpig, parse, extraction, export, opencv, image, skia</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>Semita Consulting</Authors>
    <Company>Semita Consulting</Company>
    <Version>2.0.0</Version>
    <Description>A C# library to extract tabular data from PDFs (port of camelot Python version using PdfPig). Contains OpenCvSharp4 for image processing used in the Lattice parser, with cross-platform page rendering via PdfPig.Rendering.Skia. Forked and maintained by Semita Consulting; original work by BobLd.</Description>
    <PackageProjectUrl>https://github.com/semita-consulting/camelot-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/semita-consulting/camelot-sharp</RepositoryUrl>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <!-- This ported code predates nullable reference types. Use 'annotations' (annotation
         context on for consumers, nullable warnings off) rather than the standard 'enable'
         until the port is properly annotated. TODO: annotate and switch back to enable.
         SkiaImageProcessor.cs (new code) is written nullable-clean. -->
    <Nullable>annotations</Nullable>
    <!-- Ship XML docs but don't fail CI over members the upstream fork never documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- Native OpenCV runtimes: Windows for local dev, Linux for our hosted services. -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <!-- Cross-platform page rendering (replaces the Windows-only System.Drawing path).
         Pinned to the 0.1.14.x build that pairs with PdfPig 0.1.14 (same version used in Maestro). -->
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.14.2" />
    <!-- SkiaSharp native binaries for headless Linux hosts (no GL/font system deps). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Camelot\Camelot.csproj" />
  </ItemGroup>

</Project>
