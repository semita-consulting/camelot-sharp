<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Interim local feed for the shared Semita.* packages until the SemitaOnly Azure DevOps
         feed is restored. Mirrors the convention used by the sibling InternalTools repos. -->
    <add key="SemitaLocal" value="E:\git\Semita\_localfeed" />
  </packageSources>
</configuration>
