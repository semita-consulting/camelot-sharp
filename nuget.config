<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- camelot-sharp consumes only public packages, so unlike the sibling repos it does
         NOT add the SemitaLocal feed (that path does not exist on CI runners and breaks
         restore). Add it back only if a Semita.* package reference is ever introduced. -->
  </packageSources>
</configuration>
