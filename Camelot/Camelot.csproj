<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework (net10.0), Nullable, ImplicitUsings and LangVersion come from
       ..\Directory.Build.props (Semita internal standard). -->
  <PropertyGroup>
    <Authors>Semita Consulting</Authors>
    <Company>Semita Consulting</Company>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>A C# library to extract tabular data from PDFs (port of camelot Python version using PdfPig). Forked and maintained by Semita Consulting; original work by BobLd.</Description>
    <PackageTags>pdf, extract, table, camelot, pdfpig, parse, extraction, export</PackageTags>
    <RepositoryUrl>https://github.com/semita-consulting/camelot-sharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/semita-consulting/camelot-sharp</PackageProjectUrl>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.14" />
  </ItemGroup>

</Project>
